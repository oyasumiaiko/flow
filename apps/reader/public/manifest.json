{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "Flow Cloud Reader",
  "short_name": "Flow",
  "description": "A private, cross-device EPUB library and reader",
  "lang": "zh-CN",
  "icons": [
    {
      "src": "/icons/192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/icons/512.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "/icons/maskable-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#24292e",
  "background_color": "#fff",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "any",
  "categories": ["books", "productivity"],
  "prefer_related_applications": false,
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/epub+zip": ".epub",
        "application/epub": ".epub"
      },
      "launch_type": "single-client"
    }
  ]
}
